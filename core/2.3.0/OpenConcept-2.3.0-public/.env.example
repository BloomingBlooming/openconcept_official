# V2's native/default database is SQLite and needs no DB environment values.
# Deployment profile defaults to web-hosting. PostgreSQL and Standard RAG do
# not require Docker or a saved deployment-target classification.
OPENCONCEPT_DEPLOYMENT_PROFILE=web-hosting
# OPENCONCEPT_RAG_COMPOSE_PROJECT=openconcept-v2-3-rag
# Existing manually managed MySQL installations may keep the legacy variables
# below. New adapter migrations are configured in the administrator UI.
# OPENCONCEPT_DSN="mysql:host=127.0.0.1;dbname=openconcept;charset=utf8mb4"
# OPENCONCEPT_DB_USER=openconcept
# OPENCONCEPT_DB_PASSWORD=change-me
# OPENCONCEPT_TABLE_PREFIX=openconcept_
# Maximum time to wait for existing database requests before a migration
# returns safely to SQLite instead of waiting indefinitely (3-120 seconds).
OPENCONCEPT_DATABASE_DRAIN_TIMEOUT_SECONDS=15
# Optional native dump binary overrides used by create-database-backup.php.
# OPENCONCEPT_MYSQLDUMP_BINARY=mysqldump
# OPENCONCEPT_PG_DUMP_BINARY=pg_dump

# OpenAI Responses API
OPENAI_API_KEY=sk-your-key
OPENCONCEPT_OPENAI_MODEL=gpt-5.6-luna
OPENCONCEPT_OPENAI_TIMEOUT=120
OPENCONCEPT_OPENAI_MAX_OUTPUT_TOKENS=6000
OPENCONCEPT_OPENAI_RETRIES=1
# Translation Provider migration defaults. New installations should configure
# the dedicated connection in Settings > Translation. Secrets remain server-side.
# The shared OpenAI values above are inherited until dedicated settings are saved.
OPENCONCEPT_TRANSLATION_OPENAI_MODEL=gpt-5.6-luna
OPENCONCEPT_TRANSLATION_TIMEOUT=120
OPENCONCEPT_TRANSLATION_MAX_OUTPUT_TOKENS=8000
OPENCONCEPT_AI_SEARCH_EXPANSION_MAX_TOKENS=800
OPENCONCEPT_AI_SEARCH_ANSWER_MAX_TOKENS=2500
OPENCONCEPT_AI_SEARCH_CANDIDATE_LIMIT=12
OPENCONCEPT_AI_SEARCH_MAX_CONTEXT_CHARS=24000
OPENCONCEPT_AI_CURRENT_PAGE_MAX_CONTEXT_CHARS=140000
OPENCONCEPT_AI_CURRENT_PAGE_MAX_IMAGES=4
OPENCONCEPT_AI_CURRENT_PAGE_MAX_IMAGE_BYTES=5242880
OPENCONCEPT_AI_CURRENT_PAGE_MAX_IMAGE_TOTAL_BYTES=10485760
OPENCONCEPT_AI_LINKED_FILE_LIMIT=2
OPENCONCEPT_AI_LINKED_FILE_MAX_BYTES=15728640
OPENCONCEPT_AI_LINKED_FILE_MAX_TOTAL_BYTES=25165824
OPENCONCEPT_AI_LINKED_PDF_DETAIL=low
OPENCONCEPT_AI_SEARCH_MAX_QUESTION_CHARS=1000
OPENCONCEPT_AI_SEARCH_RATE_LIMIT=8

# OpenConcept Standard RAG (OpenAI-compatible BGE-M3 Dense endpoint).
# RAG Core and Standard RAG are built into OpenConcept and have no plugin
# enable/disable control. Select Standard RAG when PostgreSQL, pgvector, and the
# embedding endpoint requirements are ready.
# Dimensions are discovered from the endpoint unless explicitly supplied.
# OPENCONCEPT_BGE_M3_BASE_URL=https://embedding.example.com/v1
# OPENCONCEPT_BGE_M3_API_KEY=replace-with-server-side-secret
# OPENCONCEPT_BGE_M3_MODEL=BAAI/bge-m3
# OPENCONCEPT_BGE_M3_REVISION=
# Optional dimension assertion. Leave unset to discover it from the provider response.
# OPENCONCEPT_BGE_M3_DIMENSIONS=
# Docker Standard RAG uses an internal HTTP endpoint. These exceptions must be
# enabled only for the audited Docker service or loopback endpoint.
# OPENCONCEPT_BGE_M3_ALLOW_PRIVATE_NETWORK=1
# OPENCONCEPT_BGE_M3_ALLOW_HTTP=1
# Custom RAG and additional OpenAI-compatible LLM secrets may use any
# administrator-selected environment name. These are the UI defaults.
# OPENCONCEPT_CUSTOM_RAG_API_KEY=replace-with-server-side-secret
# 図面管理プラグイン（図面番号・改訂番号・品名をVisionで候補化）
OPENCONCEPT_DRAWING_MAX_MB=50
OPENCONCEPT_DRAWING_VISION_TIMEOUT=120
OPENCONCEPT_DRAWING_VISION_RETRIES=1
OPENCONCEPT_DRAWING_VISION_MAX_MB=15
OPENCONCEPT_DRAWING_VISION_RATE_LIMIT=6
OPENCONCEPT_DRAWING_VISION_IMAGE_DETAIL=original
OPENCONCEPT_DRAWING_VISION_PDF_DETAIL=high
# AI音声会話プラグイン（未指定時は上のテキストモデルを使用）
OPENCONCEPT_VOICE_LLM_MODEL=gpt-5.6-luna
OPENCONCEPT_VOICE_STT_MODEL=gpt-transcribe
OPENCONCEPT_VOICE_REASONING_EFFORT=low
OPENCONCEPT_VOICE_MAX_OUTPUT_TOKENS=1200
OPENCONCEPT_VOICE_MAX_AUDIO_MB=10
OPENCONCEPT_VOICE_RATE_LIMIT=12
OPENCONCEPT_VOICE_TIMEOUT=120
# PHPのcurl.cainfoが未設定の場合のみ、信頼できるCAバンドルの絶対パスを指定します。
# OPENCONCEPT_CA_BUNDLE=/absolute/path/to/cacert.pem

# Trusted absolute application URL (required before issuing a static public site)
OPENCONCEPT_APP_URL=https://openconcept.example.com

# Static public-site runtime. When omitted, V2 uses <project>/published.
# Set an absolute directory only when the web server serves that exact path.
# OPENCONCEPT_PUBLIC_SITE_DIR=/absolute/path/to/openconcept/published
# Optional URL base corresponding to that directory (defaults to APP_URL/published).
# OPENCONCEPT_PUBLIC_SITE_URL=https://openconcept.example.com/published
# The file contains the private HMAC key, not the environment variable itself.
# When omitted it is generated on first publication at storage/publication-signing.key.
# On Windows, OpenConcept verifies and, when needed, repairs the private NTFS ACL before use.
# If the PHP service identity cannot change an unsafe ACL, publication stops and administrators
# are notified; the server/hosting operator must then grant the required ownership/ACL control.
# OPENCONCEPT_PUBLICATION_SIGNING_KEY_FILE=/absolute/private/path/publication-signing.key

# Optional HTTPS catalog shown in Settings > Plugins
# OPENCONCEPT_PLUGIN_CATALOG_URL=https://plugins.example.com/catalog.json

# Invitation email (production SMTP)
OPENCONCEPT_MAIL_TRANSPORT=smtp
OPENCONCEPT_MAIL_FROM=no-reply@example.com
OPENCONCEPT_MAIL_FROM_NAME=OpenConcept
OPENCONCEPT_MAIL_REPLY_TO=no-reply@example.com
OPENCONCEPT_SMTP_HOST=smtp.example.com
OPENCONCEPT_SMTP_PORT=465
OPENCONCEPT_SMTP_ENCRYPTION=ssl
OPENCONCEPT_SMTP_USERNAME=no-reply@example.com
OPENCONCEPT_SMTP_PASSWORD=change-me
OPENCONCEPT_SMTP_TIMEOUT=10
